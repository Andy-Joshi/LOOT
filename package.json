{
  "name": "loot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"npm:dev:client\"",
    "dev:all": "concurrently --kill-others-on-fail \"npm:server\" \"npm:smartbuy:backend\" \"npm:dev:client\"",
    "dev:client": "vite",
    "server": "node --watch server/index.js",
    "smartbuy:backend": "node ../smart-buy-lab/backend/src/server.js",
    "dev:full": "npm run dev",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "concurrently": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
